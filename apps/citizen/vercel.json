{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/public/:path*", "destination": "https://hope-demo-api.onrender.com/v1/public/:path*" },
    { "source": "/((?!v1/).*)", "destination": "/index.html" }
  ]
}
