rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function shelterPath(shelterId) {
      return /databases/$(database)/documents/shelters/$(shelterId);
    }

    function reservationPath(reservationId) {
      return /databases/$(database)/documents/reservations/$(reservationId);
    }

    function isReservationCode(value) {
      return value is string && value.matches('^ASH-[0-9]{4}$');
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isPositiveInt(value) {
      return value is int && value > 0;
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isValidReservationFamily(family, peopleCount) {
      return family is map
        && family.keys().hasOnly([
          'adults',
          'children',
          'elderly',
          'mobilityAssistance'
        ])
        && isNonNegativeInt(family.adults)
        && isNonNegativeInt(family.children)
        && isNonNegativeInt(family.elderly)
        && family.mobilityAssistance is bool
        && peopleCount == family.adults + family.children + family.elderly;
    }

    // A shelter capacity change is only ever half of an atomic reservation
    // write. `capacityUpdateCode` names the reservation that justifies the
    // change, and that reservation must be created in the same commit.
    function isValidShelterReservationCreateUpdate(shelterId, reservationCode) {
      let reservation = getAfter(reservationPath(reservationCode)).data;

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reserved',
          'capacityUpdateCode'
        ])
        && isReservationCode(reservationCode)
        && !exists(reservationPath(reservationCode))
        && existsAfter(reservationPath(reservationCode))
        && reservation.code == reservationCode
        && reservation.shelterId == shelterId
        && reservation.status == 'RESERVED'
        && isPositiveInt(reservation.peopleCount)
        && isNonNegativeInt(resource.data.capacity)
        && isNonNegativeInt(resource.data.occupied)
        && isNonNegativeInt(resource.data.reserved)
        && isNonNegativeInt(request.resource.data.reserved)
        && request.resource.data.reserved
          == resource.data.reserved + reservation.peopleCount
        && request.resource.data.reserved <= resource.data.capacity - resource.data.occupied;
    }

    function isValidShelterArrivalCapacityUpdate(shelterId, reservationCode) {
      let reservationBefore = get(reservationPath(reservationCode)).data;
      let arrivalCount = reservationBefore.peopleCount;

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reserved',
          'occupied',
          'capacityUpdateCode'
        ])
        && isReservationCode(reservationCode)
        && exists(reservationPath(reservationCode))
        && existsAfter(reservationPath(reservationCode))
        && reservationBefore.code == reservationCode
        && reservationBefore.shelterId == shelterId
        && reservationBefore.status == 'RESERVED'
        && getAfter(reservationPath(reservationCode)).data.status == 'ARRIVED'
        && isPositiveInt(arrivalCount)
        && isNonNegativeInt(resource.data.capacity)
        && isNonNegativeInt(resource.data.occupied)
        && isNonNegativeInt(resource.data.reserved)
        && isNonNegativeInt(request.resource.data.occupied)
        && isNonNegativeInt(request.resource.data.reserved)
        && resource.data.reserved >= arrivalCount
        && request.resource.data.reserved == resource.data.reserved - arrivalCount
        && request.resource.data.occupied == resource.data.occupied + arrivalCount
        && request.resource.data.occupied <= resource.data.capacity;
    }

    function isValidReservationCreate(reservationId) {
      return request.resource.data.keys().hasOnly([
          'code',
          'shelterId',
          'shelterName',
          'peopleCount',
          'family',
          'phone',
          'status',
          'distanceKm',
          'etaMinutes',
          'bufferMinutes',
          'validityMinutes',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'code',
          'shelterId',
          'shelterName',
          'peopleCount',
          'family',
          'phone',
          'status',
          'distanceKm',
          'etaMinutes',
          'bufferMinutes',
          'validityMinutes',
          'createdAt',
          'expiresAt'
        ])
        && reservationId == request.resource.data.code
        && request.resource.data.code is string
        && request.resource.data.shelterId is string
        && request.resource.data.shelterName is string
        && request.resource.data.phone is string
        && request.resource.data.status == 'RESERVED'
        && isPositiveInt(request.resource.data.peopleCount)
        && isNonNegativeNumber(request.resource.data.distanceKm)
        && isPositiveInt(request.resource.data.etaMinutes)
        && request.resource.data.bufferMinutes == 60
        && request.resource.data.validityMinutes
          == request.resource.data.etaMinutes + request.resource.data.bufferMinutes
        && isValidReservationFamily(
          request.resource.data.family,
          request.resource.data.peopleCount
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && exists(shelterPath(request.resource.data.shelterId))
        && getAfter(shelterPath(request.resource.data.shelterId)).data.reserved
          == get(shelterPath(request.resource.data.shelterId)).data.reserved
            + request.resource.data.peopleCount
        && getAfter(shelterPath(request.resource.data.shelterId)).data.capacityUpdateCode
          == request.resource.data.code;
    }

    function isValidReservationArrivalUpdate(reservationId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'arrivedAt'
        ])
        && !resource.data.keys().hasAny(['arrivedAt'])
        && reservationId == resource.data.code
        && resource.data.status == 'RESERVED'
        && request.resource.data.status == 'ARRIVED'
        && request.resource.data.arrivedAt == request.time
        && resource.data.shelterId is string
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && isPositiveInt(resource.data.peopleCount)
        && exists(shelterPath(resource.data.shelterId))
        && existsAfter(shelterPath(resource.data.shelterId))
        && get(shelterPath(resource.data.shelterId)).data.reserved
          >= resource.data.peopleCount
        && getAfter(shelterPath(resource.data.shelterId)).data.reserved
          == get(shelterPath(resource.data.shelterId)).data.reserved
            - resource.data.peopleCount
        && getAfter(shelterPath(resource.data.shelterId)).data.occupied
          == get(shelterPath(resource.data.shelterId)).data.occupied
            + resource.data.peopleCount
        && getAfter(shelterPath(resource.data.shelterId)).data.capacityUpdateCode
          == resource.data.code;
    }

    match /disasters/{disasterId} {
      allow read: if true;
      allow write: if false;
    }

    match /shelters/{shelterId} {
      allow read: if true;

      // Phase-1 prototype: unauthenticated clients may only change capacity as
      // the shelter half of an atomic reservation create or arrival commit. The
      // reservation named by `capacityUpdateCode` must be written in the same
      // commit and must justify the exact delta, so capacity cannot be mutated
      // on its own. Production must use Firebase Authentication, role-based
      // authorization, App Check, and/or trusted backend logic.
      allow update: if request.resource.data.keys().hasAll(['capacityUpdateCode'])
        && (
          isValidShelterReservationCreateUpdate(
            shelterId,
            request.resource.data.capacityUpdateCode
          )
          || isValidShelterArrivalCapacityUpdate(
            shelterId,
            request.resource.data.capacityUpdateCode
          )
        );
      allow create, delete: if false;
    }

    match /reservations/{reservationId} {
      // Phase-1 prototype: reservation creation is narrowly constrained but
      // still unauthenticated. Production must add role-based authorization.
      allow get: if true;
      allow list: if request.query.limit <= 50
        && resource.data.status == 'RESERVED'
        && resource.data.shelterId is string;
      allow create: if isValidReservationCreate(reservationId);
      allow update: if isValidReservationArrivalUpdate(reservationId);
      allow delete: if false;
    }

    match /roadIncidents/{incidentId} {
      allow read: if true;
      allow write: if false;
    }

    // Unused by the application. Closed to all client access so it cannot be
    // read or written by unauthenticated clients.
    match /evacuationRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
