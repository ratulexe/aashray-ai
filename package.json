{
  "name": "hope",
  "private": true,
  "version": "0.1.0",
  "description": "HOPE — Hazard Outreach, Protection & Evacuation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "concurrently -k -n api,citizen,console -c blue,green,magenta \"npm run dev -w @hope/api\" \"npm run dev -w @hope/citizen\" \"npm run dev -w @hope/console\"",
    "dev:api": "npm run dev -w @hope/api",
    "dev:citizen": "npm run dev -w @hope/citizen",
    "dev:console": "npm run dev -w @hope/console",
    "db:reset": "npm run db:reset -w @hope/db",
    "build": "npm run build -w @hope/citizen -w @hope/console",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
